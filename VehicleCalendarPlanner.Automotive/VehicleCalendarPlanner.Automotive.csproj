<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android Automotive OS only: the parked MAUI UI plus a Car App Library agenda for driving. -->
		<TargetFrameworks>net11.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>VehicleCalendarPlanner.Automotive</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Family Wheels</ApplicationTitle>
		<!-- Same ID as the phone app: Google Play ships automotive builds as a separate track of the same listing. -->
		<ApplicationId>com.companyname.vehiclecalendarplanner</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android Automotive OS with the Car App Library templates host starts at Android 10. -->
		<SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
		<Features>runtime-async=on</Features>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="..\VehicleCalendarPlanner.Common\Resources\Branding\appicon.svg" ForegroundFile="..\VehicleCalendarPlanner.Common\Resources\Branding\appiconfg.svg" ForegroundScale="0.65" Color="#285B55" />
		<MauiSplashScreen Include="..\VehicleCalendarPlanner.Common\Resources\Branding\splash.svg" Color="#285B55" BaseSize="128,128" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
		<PackageReference Include="Xamarin.AndroidX.Car.App.App" Version="1.7.0.4" />
		<!-- Provides CarAppActivity, which hosts templated apps on Android Automotive OS. There is no .NET binding,
		     and the app only references it from the manifest, so it is packaged without generating C# bindings.
		     Its Java dependencies arrive through the Xamarin.AndroidX.Car.App.App binding above. -->
		<AndroidMavenLibrary Include="androidx.car.app:app-automotive" Version="1.7.0" Repository="Google" Bind="false" VerifyDependencies="false" />
		<ProjectReference Include="..\VehicleCalendarPlanner.Common\VehicleCalendarPlanner.Common.csproj" />
	</ItemGroup>

</Project>
